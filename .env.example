# Copy to .env for Docker. Replace this local database password before use.
POSTGRES_DB=attendlog
POSTGRES_USER=attendlog
POSTGRES_PASSWORD=replace-with-a-local-database-password
ATTENDLOG_PORT=8000
ATTENDLOG_SECRET_KEY=
# HTTPS deployments must set ATTENDLOG_COOKIE_SECURE=1.
# The default local mail backend writes protected .eml files under runtime/mail.
